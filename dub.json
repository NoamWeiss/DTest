    "copyright": "Copyright (c) 2026, Noam Weiss",
    "authors": [
        "Noam Weiss"
    ],
    "configurations": [
        {
            "name": "library",
            "targetType": "library",
            "sourcePaths": [
                "."
            ],
            "importPaths": [
                "."
            ],
            "excludedSourceFiles": [
                "selftest_main.d",
                "selftest_cases.d",
                "example_main.d"
            ]
        },
        {
            "name": "selftest",
            "targetType": "executable",
            "targetPath": "bin",
            "targetName": "dtest-selftest",
            "sourcePaths": [
                "."
            ],
            "importPaths": [
                "."
            ],
            "mainSourceFile": "selftest_main.d",
            "excludedSourceFiles": [
                "example_main.d"
            ]
        },
        {
            "name": "example",
            "targetType": "executable",
            "targetPath": "bin",
            "targetName": "dtest-example",
            "sourcePaths": [
                "."
            ],
            "importPaths": [
                "."
            ],
            "mainSourceFile": "example_main.d",
            "excludedSourceFiles": [
                "selftest_main.d",
                "selftest_cases.d"
            ]
        }
    ]
}
